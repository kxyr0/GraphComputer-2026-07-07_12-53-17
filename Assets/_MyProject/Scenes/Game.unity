  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "module SystemCore\n\nmode = balanced\nplatform = PC\n\nrequire Kernel
    as kernel\nrequire Data as data\nrequire Security as security\nrequire Control
    as control\n\nbudget {\n    cpu <= 72\n    memory <= 68\n    storage <= 80\n}\n\nboot
    {\n    start kernel.scheduler\n    mount data.fileSystem\n    protect data.userFiles\n   
    bind control.display\n}\n\ntick every 1s {\n    monitor kernel.load\n    monitor
    data.index\n    watch processes\n\n    if kernel.load > 80\n        throttle
    scheduler by 20\n        flush tempFiles\n        alert \"System load is critical\"\n   
    end\n}\n\nexport {\n    stability = 100 - kernel.load * 0.25\n    load = kernel.load\n   
    memoryUsage = kernel.memoryUsage\n    storageUsage = data.storageUsage\n    networkSpeed
    = data.networkSpeed\n}\n\u200B"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0aeeec9bdf545a14199a7bd4cf4541d4, type: 2}
