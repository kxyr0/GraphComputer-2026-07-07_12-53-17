--- !u!114 &671103748
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 671103746}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "module SystemCore\n\nmode = balanced\nplatform = PC\n\nrequire Kernel
    as kernel\nrequire Data as data\nrequire Security as security\nrequire Control
    as control\n\nbudget {\n    cpu <= 72\n    memory <= 68\n    storage <= 80\n}\n\nboot
    {\n    start kernel.scheduler\n    mount data.fileSystem\n    protect data.userFiles\n   
    bind control.display\n}\n\ntick every 1s {\n    monitor kernel.load\n    monitor
    data.index\n    watch processes\n\n    if kernel.load > 80\n        throttle
    scheduler by 20\n        flush tempFiles\n        alert \"System load is critical\"\n   
    end\n}\n\nexport {\n    stability = 100 - kernel.load * 0.25\n    load = kernel.load\n   
    memoryUsage = kernel.memoryUsage\n    storageUsage = data.storageUsage\n    networkSpeed
    = data.networkSpeed\n}\n\u200B"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0aeeec9bdf545a14199a7bd4cf4541d4, type: 2}
  m_sharedMaterial: {fileID: 1351659724460980628, guid: 0aeeec9bdf545a14199a7bd4cf4541d4, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
  m_fontColor32:
    serializedVersion: 2
    rgba: 4294967295
  m_fontColor: {r: 1, g: 1, b: 1, a: 1}
  m_enableVertexGradient: 0
  m_colorMode: 3
  m_fontColorGradient:
    topLeft: {r: 1, g: 1, b: 1, a: 1}
    topRight: {r: 1, g: 1, b: 1, a: 1}
