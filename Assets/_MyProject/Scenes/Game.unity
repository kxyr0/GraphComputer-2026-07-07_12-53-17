  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Game.IDE.Presentation.IdeInputCodeEditor
  tabTitleText: {fileID: 0}
  inputField: {fileID: 415035599}
  highlightText: {fileID: 912581300}
  lineNumbersText: {fileID: 607830564}
  statusText: {fileID: 0}
  tabTitle: System Core
  initialCode: "module SystemCore\r\n\r\nplatform = PC\r\n\r\nrequire Kernel as kernel\r\nrequire
    Data as data\r\noptional Security as security\r\noptional Control as control\r\n\r\nbudget
    {\r\n    cpu <= 72\r\n    memory <= 68\r\n    storage <= 80\r\n}\r\n\r\nboot
    {\r\n    start kernel.scheduler\r\n    mount data.fileSystem\r\n    scan security.firewall\r\n}\r\n\r\ntick
    every 1s {\r\n    monitor kernel.load\r\n    cache data.index\r\n\r\n    if kernel.load
    > 80\r\n        throttle data.index by 25\r\n        alert \"High Load\"\r\n   
    end\r\n}\r\n\r\nexport {\r\n    stability = 100 - kernel.load * 0.25\r\n    load
    = kernel.load\r\n}"
  insertSpacesInsteadOfTabs: 1
  spacesPerTab: 4
  enableTabIndent: 1
  useSyntaxHighlight: 1
  rawInputTextAlpha: 0.02
  syncFontSettings: 1
