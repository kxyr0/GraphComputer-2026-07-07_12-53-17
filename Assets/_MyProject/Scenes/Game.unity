  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#C586C0>module</color> <color=#9CDCFE>SystemCore</color>\n\n<color=#C586C0>mode</color>
    <color=#D4D4D4>=</color> <color=#9CDCFE>balanced</color>\n<color=#C586C0>platform</color>
    <color=#D4D4D4>=</color> <color=#9CDCFE>PC</color>\n\n<color=#C586C0>require</color>
    <color=#9CDCFE>Kernel</color> <color=#C586C0>as</color> <color=#9CDCFE>kernel</color>\n<color=#C586C0>require</color>
    <color=#9CDCFE>Data</color> <color=#C586C0>as</color> <color=#9CDCFE>data</color>\n<color=#C586C0>require</color>
    <color=#9CDCFE>Security</color> <color=#C586C0>as</color> <color=#9CDCFE>security</color>\n<color=#C586C0>require</color>
    <color=#9CDCFE>Control</color> <color=#C586C0>as</color> <color=#9CDCFE>control</color>\n\n<color=#C586C0>budget</color>
    {\n    <color=#9CDCFE>cpu</color> <color=#D4D4D4><noparse><</noparse></color><color=#D4D4D4>=</color>
    <color=#B5CEA8>72</color>\n    <color=#9CDCFE>memory</color> <color=#D4D4D4><noparse><</noparse></color><color=#D4D4D4>=</color>
    <color=#B5CEA8>68</color>\n    <color=#9CDCFE>storage</color> <color=#D4D4D4><noparse><</noparse></color><color=#D4D4D4>=</color>
    <color=#B5CEA8>80</color>\n}\n\n<color=#C586C0>boot</color> {\n    <color=#DCDCAA>start</color>
    <color=#9CDCFE>kernel</color><color=#D4D4D4>.</color><color=#C586C0>scheduler</color>\n   
    <color=#DCDCAA>mount</color> <color=#9CDCFE>data</color><color=#D4D4D4>.</color><color=#9CDCFE>fileSystem</color>\n   
    <color=#DCDCAA>protect</color> <color=#9CDCFE>data</color><color=#D4D4D4>.</color><color=#D4D4D4>userFiles</color>\n   
    <color=#DCDCAA>bind</color> <color=#9CDCFE>control</color><color=#D4D4D4>.</color><color=#D4D4D4>display</color>\n}\n\n<color=#C586C0>tick</color>
    <color=#C586C0>every</color> <color=#B5CEA8>1</color><color=#D4D4D4>s</color>
    {\n    <color=#DCDCAA>monitor</color> <color=#9CDCFE>kernel</color><color=#D4D4D4>.</color><color=#DCDCAA>load</color>\n   
    <color=#DCDCAA>monitor</color> <color=#9CDCFE>data</color><color=#D4D4D4>.</color><color=#DCDCAA>index</color>\n   
    <color=#DCDCAA>watch</color> <color=#9CDCFE>processes</color>\n\n    <color=#C586C0>if</color>
    <color=#9CDCFE>kernel</color><color=#D4D4D4>.</color><color=#DCDCAA>load</color>
    <color=#D4D4D4><noparse>></noparse></color> <color=#B5CEA8>80</color>\n       
    <color=#DCDCAA>throttle</color> <color=#C586C0>scheduler</color> <color=#C586C0>by</color>
    <color=#B5CEA8>20</color>\n        <color=#DCDCAA>flush</color> <color=#D4D4D4>tempFiles</color>\n       
    <color=#DCDCAA>alert</color> <color=#CE9178>\"System load is critical\"</color>\n   
    <color=#C586C0>end</color>\n}\n\n<color=#C586C0>export</color> {\n    <color=#9CDCFE>stability</color>
    <color=#D4D4D4>=</color> <color=#B5CEA8>100</color> <color=#D4D4D4>-</color>
    <color=#9CDCFE>kernel</color><color=#D4D4D4>.</color><color=#DCDCAA>load</color>
    <color=#D4D4D4>*</color> <color=#B5CEA8>0.25</color>\n    <color=#DCDCAA>load</color>
    <color=#D4D4D4>=</color> <color=#9CDCFE>kernel</color><color=#D4D4D4>.</color><color=#DCDCAA>load</color>\n   
    <color=#D4D4D4>memoryUsage</color> <color=#D4D4D4>=</color> <color=#9CDCFE>kernel</color><color=#D4D4D4>.</color><color=#D4D4D4>memoryUsage</color>\n   
    <color=#9CDCFE>storageUsage</color> <color=#D4D4D4>=</color> <color=#9CDCFE>data</color><color=#D4D4D4>.</color><color=#9CDCFE>storageUsage</color>\n   
    <color=#D4D4D4>networkSpeed</color> <color=#D4D4D4>=</color> <color=#9CDCFE>data</color><color=#D4D4D4>.</color><color=#D4D4D4>networkSpeed</color>\n}\n"
